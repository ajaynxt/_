rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ajayx3neha@gmail.com';
    }

    function validEnquiry() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'service', 'timeline', 'budget',
          'budgetInr', 'details', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 6
        && request.resource.data.phone.size() <= 40
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() <= 100
        && request.resource.data.timeline is string
        && request.resource.data.timeline.size() <= 80
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 80
        && request.resource.data.budgetInr is string
        && request.resource.data.budgetInr.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 5
        && request.resource.data.details.size() <= 1500
        && request.resource.data.source == 'ajaynxt.com'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    function validAnalyticsEvent() {
      return request.resource.data.keys().hasOnly([
          'event', 'path', 'session', 'source', 'createdAt'
        ])
        && request.resource.data.event is string
        && request.resource.data.event.size() >= 1
        && request.resource.data.event.size() <= 60
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 180
        && request.resource.data.session is string
        && request.resource.data.session.size() <= 60
        && request.resource.data.source == 'ajaynxt.com'
        && request.resource.data.createdAt == request.time;
    }

    match /site/{documentId} {
      allow read: if documentId == 'public';
      allow create, update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create: if validEnquiry();
      allow read, update, delete: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow create: if validAnalyticsEvent();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
